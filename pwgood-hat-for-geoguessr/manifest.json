{
  "manifest_version": 3,
  "name": "PWGood Hat for Geoguessr",
  "version": "1.0",
  "description": "Заменяет кепку из геогессера на шляпу Пугода.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "https://www.geoguessr.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}